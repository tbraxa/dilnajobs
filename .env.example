# DílnaJobs local / production environment
# Copy to .env.local for Next.js and `.env` for scripts (tsx/drizzle).
# Never put secrets in client code. NEXT_PUBLIC_* is unused on purpose.

NODE_ENV=development

# Public origin (no trailing slash). Magic-link, Stripe return URLs, origin checks.
# Empty is OK at first Vercel build (falls back to https://$VERCEL_URL or localhost).
# After DNS, set this to https://dilnajobs.cz and redeploy.
APP_URL=http://localhost:3000

# PostgreSQL 16
# App queries (non-superuser dilna_app — RLS applies). Created by migration.
DATABASE_URL=postgres://dilna_app:dilna@localhost:5432/dilnajobs
# Migrate + seed + worker expiry (docker superuser)
DATABASE_ADMIN_URL=postgres://dilna:dilna@localhost:5432/dilnajobs

# Cookie / token HMAC pepper (min 32 chars). Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Session lifetime. Empty on Vercel is fine (defaults: 14 days / 15 minutes).
SESSION_DAYS=14
MAGIC_LINK_MINUTES=15

# Optional S3-compatible CV bucket (MinIO / AWS / Cloudflare R2).
# If unset, CVs are stored on local disk under storage/cvs/ (DEV STUB).
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=dilnajobs-cvs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Max CV size in bytes (5 MiB). Empty on Vercel → 5242880.
CV_MAX_BYTES=5242880

# Payments: Stripe Checkout only. Missing STRIPE_SECRET_KEY → stub orders.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: Resend first. SMTP_URL is the fallback. Empty = console stub (dev).
EMAIL_FROM=OpenJobs <noreply@dilnajobs.cz>
RESEND_API_KEY=
SMTP_URL=

# Hourly job-expiry cron (Vercel Cron / Cloud Scheduler). Required in production if you use /api/cron/job-expiry.
CRON_SECRET=

# Optional: skip live ARES HTTP (checksum only, verification_status=pending).
ARES_DISABLED=false
# ARES HTTP timeout in milliseconds (default 4000).
ARES_TIMEOUT_MS=4000

# First employer job stays in pending_review unless this is true (seed uses published jobs).
FEATURE_AUTO_PUBLISH_FIRST_JOB=false

# Trust X-Forwarded-For only behind a known proxy.
TRUST_PROXY=false

# Platform operator (/admin). Comma-separated, lowercased. Empty = nobody can sign in.
ADMIN_EMAILS=tomas@dilnajobs.test

# Optional Sentry. Empty = no-op (errors still go to structured logs).
SENTRY_DSN=

# Optional: first Vercel deploy only. Seeds sample ads if employers is empty. Default off.
SEED_ON_DEPLOY=false
# Local / preview demo seed (truncate + insert multi-profession jobs unless SEED_ON_DEPLOY skip applies).
DEMO_SEED=true


# DílnaJobs local / production environment
# Copy to .env.local for Next.js and `.env` for scripts (tsx/drizzle).
# Never put secrets in client code. NEXT_PUBLIC_* is unused on purpose.

NODE_ENV=development

# Public origin (no trailing slash). Used for magic-link URLs and CSRF origin checks.
APP_URL=http://localhost:3000

# PostgreSQL 16
# App queries (non-superuser dilna_app — RLS applies). Created by migration.
DATABASE_URL=postgres://dilna_app:dilna@localhost:5432/dilnajobs
# Migrate + seed + worker expiry (docker superuser)
DATABASE_ADMIN_URL=postgres://dilna:dilna@localhost:5432/dilnajobs

# Cookie / token HMAC pepper (min 32 chars). Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Session lifetime
SESSION_DAYS=14
MAGIC_LINK_MINUTES=15

# Optional S3-compatible CV bucket (MinIO / AWS / Cloudflare R2).
# If unset, CVs are stored on local disk under storage/cvs/ (DEV STUB).
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=dilnajobs-cvs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Max CV size in bytes (5 MiB)
CV_MAX_BYTES=5242880

# Payments: Stripe Checkout OR GoPay.
# If both secret keys are missing, checkout is a documented stub (FEATURE_PAYMENTS=false).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=

# Email: v1 logs to stdout. SMTP is a stub until a provider is wired.
EMAIL_FROM=DílnaJobs <noreply@dilnajobs.cz>
SMTP_URL=

# First employer job stays in pending_review unless this is true (seed uses published jobs).
FEATURE_AUTO_PUBLISH_FIRST_JOB=false

# Trust X-Forwarded-For only behind a known proxy.
TRUST_PROXY=false

# Platform operator (/admin). Comma-separated, lowercased. Empty = nobody can sign in.
ADMIN_EMAILS=tomas@dilnajobs.test

# Optional Sentry. Empty = no-op (errors still go to structured logs).
SENTRY_DSN=

{
  "name": "dilnajobs",
  "version": "0.1.0",
  "private": true,
  "description": "DílnaJobs — Czech job board for manufacturing and shop-floor roles.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "magic:dev": "tsx scripts/dev-magic-link.ts",
    "magic:admin": "tsx scripts/dev-admin-link.ts",
    "worker": "tsx src/worker.ts",
    "compose:up": "docker compose up -d",
    "ci": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@sentry/nextjs": "^9.47.1",
    "drizzle-orm": "^0.44.5",
    "next": "15.5.25",
    "pg-boss": "^10.3.2",
    "postgres": "^3.4.7",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20.19.11",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.5.25",
    "pg": "^8.16.3",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
